# Public canonical origin (no trailing slash). Use the deployed production URL.
NEXT_PUBLIC_SITE_URL=https://project-njo3j.vercel.app

# Server-only Razorpay keys; use test keys locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Server-only email key. Verify ebenezerministries.in in Resend.
RESEND_API_KEY=

# Optional dedicated language playlists (YouTube playlist IDs, not URLs).
# Without these, the latest matching Sunday recording is found in the public feed.
YOUTUBE_TAMIL_KANNADA_PLAYLIST_ID=
YOUTUBE_ENGLISH_HINDI_PLAYLIST_ID=
