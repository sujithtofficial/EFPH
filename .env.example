# Public canonical origin (no trailing slash). Use the deployed production URL.
NEXT_PUBLIC_SITE_URL=https://project-njo3j.vercel.app

# Server-only Razorpay keys; use test keys locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Server-only email key. Verify ebenezerministries.in in Resend.
RESEND_API_KEY=

# Server-only YouTube Data API v3 key. Required for verified broadcast status.
# Never use a NEXT_PUBLIC_ prefix for this key.
YOUTUBE_API_KEY=

# Optional dedicated language archive/discovery playlists (IDs, not URLs).
YOUTUBE_TAMIL_KANNADA_PLAYLIST_ID=
YOUTUBE_ENGLISH_HINDI_PLAYLIST_ID=

# Optional current broadcast IDs. Useful for unlisted or unusually titled events.
# Videos must belong to the configured church channel. Update/remove after use.
YOUTUBE_TAMIL_KANNADA_VIDEO_ID=
YOUTUBE_ENGLISH_HINDI_VIDEO_ID=
